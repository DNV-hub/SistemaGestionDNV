# Copiar a .env y completar con los datos del proyecto Supabase (dev).
# .env nunca se commitea (ver .gitignore).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Webhook de Power Automate que deposita el Excel del RDC en SharePoint.
VITE_POWER_AUTOMATE_RDC_URL=

# Webhook de Power Automate que deposita las fotos del RDC en SharePoint.
VITE_POWER_AUTOMATE_FOTOS_URL=
